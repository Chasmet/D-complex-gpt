<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:id="@+id/versionText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Version installée"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Connexion MCP"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/mcpUrlInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="https://ton-serveur-mcp.example.com/mcp"
            android:inputType="textUri"
            android:maxLines="1" />

        <EditText
            android:id="@+id/mcpTokenInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Jeton MCP si nécessaire"
            android:inputType="textPassword"
            android:maxLines="1" />

        <Button
            android:id="@+id/testMcpButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Tester MCP"
            android:textAllCaps="false" />

        <TextView
            android:id="@+id/mcpStatusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="MCP non testé"
            android:textSize="12sp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="18dp"
            android:layout_marginBottom="14dp"
            android:background="#33000000" />

        <CheckBox
            android:id="@+id/autoUpdateCheck"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Mise à jour automatique au démarrage" />

        <Button
            android:id="@+id/checkUpdateButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Vérifier la mise à jour maintenant"
            android:textAllCaps="false" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="D-Complex GPT n’utilise aucune clé API OpenAI. La connexion externe de l’application passe uniquement par MCP."
            android:textSize="12sp" />

    </LinearLayout>
</ScrollView>
